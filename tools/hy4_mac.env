# Kernel and cache flags of the Hy4-flash serve line (Mac Studio, 256K context). Load before the server:
#   set -a; . tools/hy4_mac.env; set +a
KYOJIN_KQ_GMM_GLM=1
KYOJIN_KQGMM_KLOW=1
KYOJIN_HY4_SWA_SLICE=1
KYOJIN_SHARED_INPUT_GEMV=1
KYOJIN_KPOOL_KEYCACHE=1
KYOJIN_KPOOL_FUSE=1
KYOJIN_EXPERT_GATEUP_PAIR=1
KYOJIN_HC_ID_FUSE=1
KYOJIN_ENGRAM_DEVICE=1
KYOJIN_FOREIGN_CASTFREE=1
KYOJIN_STEP_COMPILE=1
KYOJIN_STEP_COMPILE_ATTN=1
KYOJIN_SKINNY_ROWS=8
KYOJIN_HY4_FIXED_KV=1
KYOJIN_SPLIT=1
KYOJIN_HY4_MTP=1
KYOJIN_HY4_MTP_DEPTH=3
KYOJIN_HY4_MTP_FIXED=1
KYOJIN_HY4_HEAD_Q=8
KYOJIN_HEAD_Q=8
KYOJIN_FOREIGN_FMM8=2
KYOJIN_FOREIGN_FMM8_MAX=8
KYOJIN_MOE_ROUTE_SEL=1
KYOJIN_FOREIGN_NBR_SMALL=1
KYOJIN_HY4_ATTN_FUSE=1
KYOJIN_HY4_ATTN_QBLK_SWA=128
KYOJIN_FOREIGN_WIDE_MAX=100000
KYOJIN_KQ_GMM_MT=32
KYOJIN_HY4_PF_FP16=1
KYOJIN_HY4_ATTN_FLASH=1
KYOJIN_HY4_ATTN_FLASH_SWA=1
KYOJIN_HY4_HC_FUSE=1
# one-launch MLA decode attention core (windowed and pooled-key layers)
KYOJIN_HY4_ATTN_VEC=2
# Q3_K expert decode: fused decode + dot, no float weights (1.10.3; KYOJIN_QDEC_FAST=0 restores the decode-to-float text)
KYOJIN_QDEC_FAST=1
# MLA absorb products as one per-head GEMV launch over the fp16 k_b / v_b copies, one resident fp16 copy (1.10.3; KYOJIN_ABSORB_GEMV=0 = stock fp32 matmul)
KYOJIN_ABSORB_GEMV=1
# long context (1.10.3): kept-key gather attention from 16384 key slots on a verify round, from 8192 on a plain step, pooled keys carried in the cache state (KYOJIN_HY4_FIXED_GATHER=0 / _DEC=0 / PKCACHE=0 switch each off)
KYOJIN_HY4_FIXED_GATHER=16384
KYOJIN_HY4_FIXED_GATHER_DEC=8192
KYOJIN_HY4_FIXED_PKCACHE=1
# Engram rows stay on disk: deduplicated parallel preads, and the rows of a speculative round are prefetched while the draft head runs (no table warm-up)
KYOJIN_HY4_ENGRAM_PREAD=1
KYOJIN_HY4_ENGRAM_DECPF=1
# the Hy4 model row is an unproven skeleton row: both switches are required
KYOJIN_SKELETON=1
KYOJIN_KIT_UNPROVEN_ROWS=1
MLX_METAL_RESIDENCY_REFRESH_INTERVAL_MS=1000
# memory guard (default on): process budget in GiB, default 0.88 x physical RAM (about 225 on a 256 GB Mac Studio); 0 = off.
# KYOJIN_MEM_GIB_PER_1K (default 0.12) is the projected GiB per 1000 prompt tokens, KYOJIN_MEM_CHECK_TICKS (default 16) the decode ticks between checks
#KYOJIN_MEM_BUDGET_GIB=225
