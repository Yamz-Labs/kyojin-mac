# Kernel and cache flags of the Hy4-flash serve line (Mac Studio, 256K context). Load before the server:
#   set -a; . tools/hy4_mac.env; set +a
KYOJIN_KQ_GMM_GLM=1
KYOJIN_KQGMM_KLOW=1
KYOJIN_HY4_SWA_SLICE=1
KYOJIN_SHARED_INPUT_GEMV=1
KYOJIN_KPOOL_KEYCACHE=1
KYOJIN_KPOOL_FUSE=1
KYOJIN_EXPERT_GATEUP_PAIR=1
KYOJIN_HC_ID_FUSE=1
KYOJIN_ENGRAM_DEVICE=1
KYOJIN_FOREIGN_CASTFREE=1
KYOJIN_STEP_COMPILE=1
KYOJIN_STEP_COMPILE_ATTN=1
KYOJIN_SKINNY_ROWS=8
KYOJIN_HY4_FIXED_KV=1
KYOJIN_SPLIT=1
KYOJIN_HY4_MTP=1
KYOJIN_HY4_MTP_DEPTH=5
KYOJIN_HY4_MTP_FIXED=1
KYOJIN_HY4_HEAD_Q=8
KYOJIN_HY4_ATTN_FUSE=1
KYOJIN_HY4_ATTN_QBLK_SWA=128
KYOJIN_FOREIGN_WIDE_MAX=100000
KYOJIN_KQ_GMM_MT=32
KYOJIN_HY4_PF_FP16=1
KYOJIN_HY4_ATTN_FLASH=1
KYOJIN_HY4_ATTN_FLASH_SWA=1
KYOJIN_HY4_HC_FUSE=1
# long context: fixed-state gather attention over the kept keys (prefill from 16384 key slots, decode and verify rows from 32768)
KYOJIN_HY4_FIXED_GATHER=16384
KYOJIN_HY4_FIXED_GATHER_DEC=32768
KYOJIN_HY4_FIXED_PKCACHE=1
# the Hy4 model row is an unproven skeleton row: both switches are required
KYOJIN_SKELETON=1
KYOJIN_KIT_UNPROVEN_ROWS=1
MLX_METAL_RESIDENCY_REFRESH_INTERVAL_MS=1000
